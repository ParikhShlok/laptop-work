# Required to enable search. Use a long random value and keep it private.
APP_ACCESS_SECRET=replace-with-a-long-random-secret

# Optional Telegram notification settings (create a bot with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMPTY_SEARCH=false

# Optional. Only configure an OAuth2 token issued through an authorized Freelancer.com developer app.
# Do not enter your marketplace password, cookies, or browser session token.
FREELANCER_OAUTH_TOKEN=
