# SecureScan V1 Environment Configurations

# Database Settings
# For development, SQLite is used: sqlite:///./securescan.db
# For production, use PostgreSQL: postgresql://user:password@localhost:5432/securescan
DATABASE_URL=sqlite:///./securescan.db

# Security Settings
# Make sure to change these keys in a production environment
SECRET_KEY=dev_secret_key_change_me_to_something_secure_and_long_1234567890
JWT_SECRET=dev_jwt_secret_key_change_me_to_something_secure_and_long_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scanner Settings
# Path to Nmap executable (on Windows, specify full path if not in system PATH)
NMAP_PATH=nmap
# URL for OWASP ZAP API proxy
ZAP_URL=http://localhost:8080
ZAP_API_KEY=

# Engine Configurations
SCAN_TIMEOUT=600
MAX_CONCURRENT_SCANS=3
ALLOW_PRIVATE_TARGETS=true
