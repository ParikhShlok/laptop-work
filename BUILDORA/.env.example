# BUILDORA Environment Configuration
# Never commit real secrets to source control!

# Public marketing site
# Set this to your Calendly/TidyCal/Cal.com booking page before publishing the static demo.
# Example: VITE_BOOKING_URL=https://calendly.com/your-name/buildora-pilot
VITE_BOOKING_URL=

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./buildora.db
# Persistent API database for the authenticated pilot flow. SQLite is suitable
# only for a single local/server instance. Move to PostgreSQL before scaling.
PILOT_DATABASE_URL=sqlite:///./buildora-pilot.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/buildora

# Redis (Workers / Cache)
REDIS_URL=redis://localhost:6379/0

# AI Provider API Keys (Supports OpenAI, Anthropic, Gemini)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_AI_API_KEY=AIzaSy-your-google-ai-key-here

DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

# Global Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# India Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# OAuth Integrations
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=...
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=...
GOOGLE_MEET_WEBHOOK=https://api.buildora.ai/webhooks/meet

# Security & Session Tokens
SECRET_KEY=generate-a-strong-random-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
